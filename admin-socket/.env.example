PORT=8090

# Total WS connection guard (all kinds)
MAX_WS_TOTAL=20000

# Admin WS-specific limits
MAX_WS_ADMIN=15000
MAX_WS_PER_ADMIN=5

# Optional: Service WS (reserved for future use)
MAX_WS_SERVICE=0

# Backpressure (bytes) before we start dropping queued sends
MAX_BACKPRESSURE=65536

# HTTP push simple rate limit (requests/second)
PUSH_RPS=2000

