PORT=8080
# Either provide the public key inline as ONE line with \n, or point to a file path
AUTH_PUBLIC_PEM=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_TEST_PEM\n-----END PUBLIC KEY-----
# AUTH_PUBLIC_PEM_FILE=C:\\path\\to\\public.pem
RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_EXCHANGE=ws_ingress
RABBIT_ROUTING_KEY=client.event
IDLE_TIMEOUT=120
MAX_PAYLOAD=1048576
REDIS_URL=redis://localhost:6379
