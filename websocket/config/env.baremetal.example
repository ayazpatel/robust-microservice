PORT=443
# Either provide the public key inline as ONE line with \n, or point to a file path
AUTH_PUBLIC_PEM=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PROD_PEM\n-----END PUBLIC KEY-----
# AUTH_PUBLIC_PEM_FILE=/etc/keys/public.pem
RABBIT_URL=amqp://user:pass@rabbit-internal:5672/vhost
RABBIT_EXCHANGE=ws_ingress
RABBIT_ROUTING_KEY=client.event
IDLE_TIMEOUT=120
MAX_PAYLOAD=1048576
REDIS_URL=redis://127.0.0.1:6379
SSL_KEY=/etc/ssl/private/your.key
SSL_CERT=/etc/ssl/certs/your.crt
