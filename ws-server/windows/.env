# Copy to .env and edit values for local runs

# Server
PORT=8080
IDLE_TIMEOUT=120
MAX_PAYLOAD=1048576
MAX_BACKPRESSURE=65536
WS_WELCOME=false
WS_ACK=false
DEBUG_WS=true
WS_COMPRESSION=none

# Auth (choose ONE of the following)
#AUTH_PUBLIC_PEM_FILE=E:\\path\\to\\public.pem
#AUTH_PUBLIC_PEM_B64=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0K...
#AUTH_PUBLIC_PEM="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA263OPknb2RSHHUJ5FUk+\n0wQlXMnjP38Yf5DeX3r1Ut+9ZbdsPU3+GQDB9B9AueYa2a/sIUVycjuJ1+Tu3nlg\n16/Wt5iKXHMSBfuE32HDmJOoCMBkBVmKavZnQR2njLfcBV516p5NXD62zJqw0tJO\nqvlR9N62AJhqdjvp9qtzbZZgWDpxsp4IS4F8kq3+SjDeErtM+kdx0ux1908dmopq\nn+8YDxlqrRDkrPZUJcAQISDI3dJF2hw1Z5f+RJcSOrmrzomNuchK9WSZuJUYvA/6\nKzzqELjXkmp1OgE6LM/zRAWq5gTO1J23Ge/My7fegA5dod5efBzUiiubdq95lSmJ\ntQIDAQAB\n-----END PUBLIC KEY-----\n"

# Dev mode (bypasses JWT verification; for local testing only)
AUTH_DEV_MODE=true

# RabbitMQ
RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_EXCHANGE=ws_ingress
RABBIT_ROUTING_KEY=client.event

# Redis
REDIS_URL=tcp://127.0.0.1:6379

ALLOW_ORIGIN=http://localhost:5173
